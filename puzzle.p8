--misc
function parts_init()
 parts={}
	for i=1,400 do
		add(parts,{
		x=rnd(128),
		y=rnd(100)-100,
		c=rnd({10,12,14}),
		d=rnd(2)-1,
		t=rnd(1),
		})
	end
end

function parts_update()
	for p in all(parts) do
		pset(p.x,p.y,p.c)
		p.x+=((p.t>=0.25 or p.t<0.75) and cos(p.t) or -cos(p.t))
		p.t+=0.03
		p.t%=1
		p.y+=(sin(p.t)+1)/2
		if p.y >128  then
			del(parts,p)
		end
	end
end

function lpack_square(_pack,lpx,lpy)
	for yy=0,59 do
		for xx=1,60 do
			pset(lpx+xx,lpy+yy,tonum(_pack[xx+60*yy],1))
		end
	end
end

function future(round,cha,nah)
	if (round==-1) return "not close"
	if (cha and won())  return "close!"
	nah=nah or 0
	for i=g,#b do
		local bt={b[i][1],b[i][2],b[i][3]}
		blocks(bt)
		local ta=makea()
		nah+=#ta
		if (nah>40) return "not close"
		for j=1,#ta do
			b[i][1],b[i][2]=ta[j][1],ta[j][2]
			local zzz=future(round-1,true,nah)
			b[i][1],b[i][2]=bt[1],bt[2]
			if (zzz=="close!") return zzz
		end
	end
	
	return "not close"
end

function eq(co1,co2)
	return co1[1]==co2[1] and co1[2]==co2[2]
end

function inbounds(px,py)
 if px>6 or px<1 or py>6 or py<1 then
 	return false
	end
 return true
end

function back()
	if (mhov(0,-10,20,20)) pal(6,7)
	rectfill(0,2,16,8,6)
	circfill(18,5,3,6)
	?"\f1<<",3,3
	?"\f1x",14,3
	palr()
	return mlrlk() or mclk(0,-10,20,20)
end

function te(upd)
	spr(75,33-upd,32-upd) spr(75,41-upd,32-upd)
 spr(75,49-upd,32-upd) spr(75,41-upd,40-upd)
 spr(75,41-upd,48-upd) 
end

function maketemp()
	local btemp={b[1]}
	for i=2,#b do
		add(btemp,{b[i][1],b[i][2],b[i][3]})
	end
	return btemp
end

function makea()
	local ta={}
	for i=1,#a do
		ta[i]={a[i][1],a[i][2]}
	end
	return ta
end

function dorwell(d,dc)
	if (dc) pal(7,13)
	spr(10,d[1]*16,d[2]*16,2,2)
	palr()
end

function mclk(m1x,m1y,m2x,m2y)
	return mpc==1 and mhov(m1x,m1y,m2x,m2y)
end

function mhov(m1x,m1y,m2x,m2y)
	--set m2 relative to m1 (so size)
	return mt<80 and mpx>m1x and mpx<m1x+m2x and mpy>m1y and mpy<m1y+m2y
end

function mlclk()
	return btnp(🅾️) or mpc==1
end

function mlrlk()
	return btnp(❎) or mpc==2
end

function clk()
	return mlclk() or mlrlk()
end


function palr()
	for i=1,15 do
		pal(i,i)
	end
end

function flnd(fo)
	return flr(rnd(fo))+1
end

function lockblock(buf)
	buf=buf or 0
	sdx,sdy=3,3
	if (x<sx) sdx-=1
	if (x>sx) sdx+=1
	if (y<sy) sdy-=1
	if (y>sy) sdy+=1
	upn={16*blsp-29+buf,35}
	if(#a==0) upn[2]=51 
	sspr(upn[1],upn[2],10-buf,10,sx*16+sdx,sy*16+sdy)	
end

function getblock(gbx,gby)
	for i=g,#b do
		if eq(b[i],{gbx,gby}) then
			return i
		end
	end
end

function dotdot(g)
		g=g or lock
		for i=1,#a do
			r,dx,dy,xflip,yflip=17,a[i][1],a[i][2]
			if rb[i] then
				r,dx,dy=18,rb[i][1],rb[i][2]
				if(dx==sx) r=20
				if(dy==sy) r=19
			 yflip=dy<sy
			 xflip=dx<sx
		end
		if (not (cur==15 and lp==6)) spr(r,dx*16+4,dy*16+4,1,1,xflip,yflip)
	
	
		if mlclk() and eq({x,y},{dx,dy}) then
			add(un,{b[g][1],b[g][2],g})
			x,y=a[i][1],a[i][2]
			b[g][1],b[g][2]=x,y
			--sfx(0)
		end
	end
end

function highlight(con)
	color(con and 10 or 7)
end

function bp(inx,n)
	return  b[inx][n or 2]*16
end

function una()
	return un[#un]
end

