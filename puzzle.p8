--misc
function parts_init()
 parts={}
	for i=1,400 do
		add(parts,{
		x=rnd(128),
		y=rnd(100)-100,
		c=rnd({10,12,14}),
		d=rnd(2)-1,
		t=rnd(1),
		})
	end
end

function parts_draw()
	for p in all(parts) do
		pset(p.x,p.y,p.c)
	end
end

function parts_update()
	for p in all(parts) do
		p.x+=((p.t>=0.25 or p.t<0.75) and cos(p.t) or -cos(p.t))
		p.t+=0.03
		p.t%=1
		p.y+=(sin(p.t)+1)/2
		if p.y >128  then
			del(parts,p)
		end
	end
end

function lpack_square(_pack,lpx,lpy)
	for yy=0,59 do
		for xx=1,60 do
			pset(lpx+xx,lpy+yy,tonum(_pack[xx+60*yy],1))
		end
	end
end

function future(round,cha,nah)
	if (round==-1) return "not close"
	
	if round<3 then
		for q=2, g+1 do
			if (eq(b[q],b[cha])) then
				if(won()) return "close!"
			end
		end
	end
	
	if (nah==nil) nah=0
	
	for i=g+2,#b do
		local bt={b[i][1],b[i][2],b[i][3]}
		
		a={}
		blocks(bt)

		local ta={}
		for j=1,#a do
			ta[j]={a[j][1],a[j][2]}
		end
		nah+=#ta
		if (nah>40) return "not close"
		for j=1,#ta do
			b[i][1]=ta[j][1]
			b[i][2]=ta[j][2]
			local zzz=future(round-1,i,nah)
			b[i][1]=bt[1]
			b[i][2]=bt[2]
			
			if (zzz=="close!") return zzz
		end
	end
	
	return "not close"
end

function eq(co1,co2)
	if (co1[1]==co2[1] and co1[2]==co2[2]) return true
	return false
end

function contains(px,py)
	for i=g+2,#b do
		if (eq({px,py},b[i])) return true
	end
	return false
end

function inbounds(px,py)
 if px>6 or px<1 or py>6 or py<1 then
 	return false
	end
 return true
end

function back()
	rectfill(0,2,16,8,6)
	circfill(18,5,3,6)
	print("<<",3,3,1)
	print("x",14,3,1)
end

function te(upd)
	spr(2,33-upd,32-upd) spr(2,41-upd,32-upd)
 spr(2,49-upd,32-upd) spr(2,41-upd,40-upd)
 spr(2,41-upd,48-upd) 
end

function maketemp()
	local btemp={b[1]}
	for i=2,#b do
		add(btemp,{b[i][1],b[i][2],b[i][3],b[i][4]})
	end
	
	return btemp
end

