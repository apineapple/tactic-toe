--main + blocks
function _init()
 debug=true
 mode="title" -- info screen flag 
 a={}
 is={8,43,78,113,148}
 counter=0
	x=1 y=1
	t_mode=0
	code=0
	fval=""
	elvl={"your level!"}
	metu={}
 
	cartdata("bens_tactic_toe")
	
	if dget(1)==0 then
		dset(1,1)
		for i=2, #lvls do
			dset(i,0)
		end
	end

	lp=dget(1)
	
	lpshift=-1*(lp-1)*80
	
	--unlock all levels
	if debug then
		for i=2,#lvls do
			dset(i,100)
		end
	end
	
	pal(1,10)
	palt(0, false)
	palt(13, true)
end

function _update()
 local modes={
		["title"]=title,
		["tutorial"]=tutorial,
		["editor"]=editor,
		["sel"]=sel,
		["lpack"]=lpack,
		["level"]=level,
		["info"]=info,
	}
 
 palt(14, false)
 cls(1) 
	modes[mode]()
end


function blocks(bl)
	if (bl[3]==1 or bl[3]==5) return
	blis={nil,reg,rocket,knight}
	blis[bl[3]](bl[1],bl[2])
end


function dir8(bx,by)
	a={}
	for dx=-1,1 do 
		for dy=-1,1 do
				if inbounds(bx+dx,by+dy) and (dx!=0 or dy!=0)then
					if (contains(bx-dx,by-dy) or 
					((dy == 0) and (contains(bx-dx,by+1) and contains(bx-dx,by-1))) or
	    ((dx == 0) and (contains(bx+1,by-dy) and contains(bx-1,by-dy))) or
	    ((dx != 0 and dy != 0) and (contains(bx,by-dy) and contains(bx-dx,by))) ) then
	     add(a,{bx+dx,by+dy})
	    end
	   end
		end
	end	
end



function reg(bx,by)
	val=2
	dir8(bx,by)
	for i=#a,1,-1 do
		if contains(a[i][1],a[i][2]) then
		 deli(a,i)
		end
	end
end
	

function rocket(bx,by)
	rock=true
	reg(bx,by)
	rb={}
	for i=1,#a do
		rb[i]={}
		rb[i][1]=a[i][1]
		rb[i][2]=a[i][2]
		local qx=a[i][1]-bx
		local qy=a[i][2]-by
		while (true) do
			if inbounds(a[i][1]+qx,a[i][2]+qy) and not contains(a[i][1]+qx,a[i][2]+qy) then
				a[i][1]+=qx
				a[i][2]+=qy
			else
				break				
			end
		end
	end
end

function knight(bx,by)
	val=3
	dir8(bx,by)	
	local k={} kx=0 ky=0
	for i=1, #a do
		kx=a[i][1]-bx
		ky=a[i][2]-by
		if kx!=0 and ky!=0 then
			if(inbounds(bx+kx,by+2*ky) and not contains(bx+kx,by+2*ky)) add(k,{bx+kx,by+2*ky})
			if(inbounds(bx+2*kx,by+ky) and not contains(bx+2*kx,by+ky)) add(k,{bx+2*kx,by+ky})		
		elseif ky!=0 then
			if(inbounds(bx+1,by+2*ky) and not contains(bx+1,by+2*ky)) add(k,{bx+1,by+2*ky})
			if(inbounds(bx-1,by+2*ky) and not contains(bx-1,by+2*ky)) add(k,{bx-1,by+2*ky})		
		elseif kx!=0 then
			if(inbounds(bx+2*kx,by+1) and not contains(bx+2*kx,by+1)) add(k,{bx+2*kx,by+1})
			if(inbounds(bx+2*kx,by-1) and not contains(bx+2*kx,by-1)) add(k,{bx+2*kx,by-1})		
		end
	end
	a=k
end

function set_b(lev)
	--redo b so its a dictionary
	--runtime o(1)
	--b[49] is 7,7 b[0 is 0,0
	currwon=false
	unt=0
	un={}
	g=0
	
	if (lp!=6 and cur!=11) metu={}

	if (lev==nil) lev=lvls[lp][cur]
	b={}
	b[1]=lev[1]
	for i=2, #lev do
		lev[i]=tostr(lev[i])
		if (#lev[i]==2) lev[i]="0"..lev[i]
		if (#lev[i]==1) lev[i]="0".."0"..lev[i]
		b[i]={
			tonum(lev[i][1]),
			tonum(lev[i][2]),
			tonum(lev[i][3]),
			tonum(lev[i][4])
		}
		if(b[i][3]==0) g+=1
		
	end
end

function won()
	local gnum=0
	
	for i=g+2,#b do
		for j=2,g+1 do
			if eq(b[i],b[j]) then
				gnum+=1
				if (gnum==g) return true
			end
		end
	end
	return false
end
