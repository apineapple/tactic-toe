--main + blocks
function _update()
	--use flags for color palette
	if (mc()>0 and mpc>0) mpc=0
 if (mpx!=mx() and mpy!=my()) or mpc==1 then
 	mt,mpx,mpy=0,mx(),my()
	else
		mt+=1
	end
	
	cls(1) 
	_ENV[mode]()
	

 if mt<80 then
  spr(14+32*min(mc(),1),mx(),my(),2,2)
 end
	mpc=mc()
	
end

function blocks(bl)
	rb={}
	a={}
	if (bl[3]==1) lock=false return
	if (bl[3]==5) return
	blis={nil,reg,rocket,knight}
	blis[bl[3]](bl[1],bl[2])
	bcut()
end

function reg(bx,by)
	a={}
	val=1
	for dx=-1,1 do 
		for dy=-1,1 do
				if dx!=0 or dy!=0 then
					if (getblock(bx-dx,by-dy) or 
					((dy==0) and (getblock(bx-dx,by+1) and getblock(bx-dx,by-1))) or
	    ((dx==0) and (getblock(bx+1,by-dy) and getblock(bx-1,by-dy))) or
	    ((dx!=0 and dy!=0) and (getblock(bx,by-dy) and getblock(bx-dx,by))) ) then
	     add(a,{bx+dx,by+dy})
	    end
	   end
		end
	end	
end

function rocket(bx,by)
	reg(bx,by)
	bcut()
	for i=1,#a do
		rb[i]={a[i][1],a[i][2]}
		qx,qy=a[i][1]-bx,a[i][2]-by
		while inbounds(a[i][1]+qx,a[i][2]+qy) and not getblock(a[i][1]+qx,a[i][2]+qy) do
			a[i][1]+=qx
			a[i][2]+=qy
		end
	end
end

function knight(bx,by)
	reg(bx,by)
	val,k=2,{}
	for i=1, #a do
		kx,ky=a[i][1]-bx,a[i][2]-by
		if kx!=0 and ky!=0 then
			add(k,{bx+kx,by+2*ky})
			add(k,{bx+2*kx,by+ky})		
		elseif ky!=0 then
			add(k,{bx+1,by+2*ky})
			add(k,{bx-1,by+2*ky})		
		else
			add(k,{bx+2*kx,by+1})
			add(k,{bx+2*kx,by-1})		
		end
	end
	for i=#k,1,-1 do
		for j=1,i-1 do
			if eq(k[i],k[j]) then
				deli(k,i)
				break
			end
		end
	end
	a=k
end

function set_b(val)
	lock=nil
	b={}
	parts_init()
	g,un,un2,unt,counter,mselect,currwon=2,{},{},0,0,1,false
	b[1]=val and val[1] or lvls[lp][cur*2-1]
	lev=val and val[2] or lvls[lp][cur*2]
	
	for i=1,#lev,3 do
		add(b,{})
		for j=0,2 do
			bn=tonum(lev[i+j])
			if(bn) add(b[#b],bn)
		end	
		if(b[#b][3]==0) g+=1
	end

end

function won()
	local gnum=2
	
	for i=g,#b do
		for j=2,g-1 do
			if eq(b[i],b[j]) then
				gnum+=1
			end
		end
	end
	
	return gnum==g
end

function bcut()
	for i=#a,1,-1 do
		if getblock(a[i][1],a[i][2]) or not inbounds(a[i][1],a[i][2]) then
		 deli(a,i)
		end
	end
end
