--orwell

function orwell(o)
	orlis={
		{chain,true,"orwell creates duplicates"},
		{dead,true,"orwell won't budge"},
		{meta,false,"orwell is everywhere"},
		{diagonal,false,"orwell hates right angles"},
		{bulldozer,false,"orwell eats blocks"},
		{gap,false,3,"orwell needs space to be pushed"},
		{undo,false,"orwell goes where others were"},
		{eye,false,"orwell uses relative position"},
		{toggle,true,"orwell toggles"},
		{metaundo,false,"orwell takes from other levels"},
		{quarter,true,"orwell's power scales with size"},

		{portal,true},
	}
	val=6
	if o!=-1 or orlis[cur][2] then
		orlis[cur][1](o)
	end
	
end

function eye(o)
	local bx=b[o][1]
	local by=b[o][2]
	a={}
	for i=g+2,#b do
		if i!=o then
			local ex=2*bx-b[i][1]
			local ey=2*by-b[i][2]
			if inbounds(ex,ey) and not contains(ex,ey) then
				add(a,{ex,ey})
			end
			
			for j=g+2,#b do
				if i!=j then
					if b[i][2]==b[j][2] and (b[i][1]+b[j][1])/2==bx then
						add(a,{bx,ey})
					elseif b[i][1]==bx and b[j][2]==by and bx-b[j][1]==by-b[i][2] then 
						local jx=2*bx-b[j][1]
						add(a,{jx,ey})
					end 
				end
			end
		end
	end
	for i=#a,1,-1 do
		if contains(a[i][1],a[i][2]) or not inbounds(a[i][1],a[i][2]) then
		 deli(a,i)
		end
	end
end

function toggle()	
	local btemp=maketemp()
	local boff={}
	
	for i=#btemp-#un%2,g+2,-2 do
		if btemp[i][3]==5 then
			deli(b,i)
			
			local tover=false
			for j=g+2,#btemp do
				if j!=i and eq(btemp[i],btemp[j]) then
					tover=true
					break
				end
			end
			
			if not tover then
				if (eq({sx,sy},btemp[i])) lock=false
				add(boff,btemp[i])
			end
		end
	end
	
	if lock then
		for i=g+2,#b do
			if eq({sx,sy},b[i]) then
				if b[i][3]!=5 then
					blocks(b[i])
				else
				 reg(sx,sy)
				end
				break
			end
		end
	end
	
	for i=1,#boff do
		pal(7,13)
		pal(14,1)
		spr(42,boff[i][1]*16,boff[i][2]*16,2,2)
		pal(7,7)
		pal(14,14)
	end 
	
	b=btemp
end

function dead()
	local btemp=maketemp()
	
	for i=#b,g+2,-1 do
		if b[i][3]==5 then
			if (eq({sx,sy},b[i])) lock=false
			pal(14,1)
			spr(42,b[i][1]*16,b[i][2]*16,2,2)
			pal(14,14)
			deli(b,i)
		end
	end	
	
	if lock then
		for i=g+2,#b do
			if eq({sx,sy},b[i]) then
				blocks(b[i])
				b=btemp
				for j=#a,1,-1 do
					if contains(a[j][1],a[j][2]) then
						deli(a,j)
					end
				end
				break
			end
		end
	end
	
	b=btemp
	
end

function meta(o)
	a={}
	for i=1,6 do
		for j=1,6 do
			if not contains(i,j) then
				add(a,{i,j})
			end
		end
	end
end

function undo(o)
	a={}
	for i=1,#un do
		if not contains(un[i][1],un[i][2]) then
			add(a,{un[i][1],un[i][2]})
		end
	end
end

function diagonal(o)

	local bx=b[o][1]
	local by=b[o][2]
	reg(bx,by)
	for i=#a,1,-1 do
		if bx==a[i][1] or by==a[i][2] then
			deli(a,i)
		end
	end
end

function chain(o)
	if (o!=-1) reg(b[o][1],b[o][2])
	if #un==unt or #un==0 or b[un[#un][3]][3]!=5 then
	 return
	elseif #un>unt then
		add(b,{un[#un][1],un[#un][2],5})
	else
		deli(b,#b)
	end
	unt=#un
end

bull={}
function bulldozer(o)
	if o!=-1 then
		dir8(b[o][1],b[o][2])
	elseif #un>unt and b[un[#un][3]][3]==5 then
		for i=g+2,#b do
			if i!=un[#un][3] and eq(b[i],b[un[#un][3]]) then
				add(bull,{b[i][1],b[i][2],i,#un})
				b[i][1]=-1
				b[i][2]=-1
			end
		end
	elseif	#bull!=0 and #un<bull[#bull][4]	then
		b[bull[#bull][3]][1]=bull[#bull][1]
		b[bull[#bull][3]][2]=bull[#bull][2]
		deli(bull,#bull)
		level()
	end
	unt=#un
end

function gap(o)
	local bx=b[o][1]
	local by=b[o][2]
	eye(o)
	for i=#a,1,-1 do
		if abs(bx-a[i][1])!=2 and abs(by-a[i][2])!=2 then
			deli(a,i)
		end
	end
end

quar={}
function quarter(o)

	if o!=-1 then
		local btemp=maketemp()
		local qs=0
		local qz={false,false,false,false}
		for i=g+2,#b do
			if eq(b[i],b[o]) then 
				qs+=1 
				qz[b[i][4]]=true
			end
		end
	
		for i=#b,g+2,-1 do
			if not eq(b[i],btemp[o]) and b[i][3]==5 then
			 local qua=0
				for j=g+2,#b do
					if (eq(b[i],b[j])) qua+=1
				end
				if (qua<qs) deli(b,i)
			end
		end
		
		dir8(btemp[o][1],btemp[o][2])
		b=btemp
		for i=#a,1,-1 do
			for j=g+2,#b do
				if eq(a[i],b[j]) and (b[j][3]!=5 or qz[b[j][4]]) then
					deli(a,i)
					break
				end
			end
		end
	end
	
	currwon=won()
	if currwon then
		for i=2,g+1 do
			local cqu=0
			for j=g+2,#b do
				if eq(b[i],b[j]) then
					if (b[j][3]!=5) cqu=4 break
					cqu+=1
				end
			end
			
			if cqu!=4 then
			 currwon=false 
			 break
			end
		end
	end
	
	
	if #un>unt and b[un[#un][3]][3]==5 then
		add(quar,{#un})
		for i=g+2,#b do
			if eq(b[i],un[#un]) then	
				add(quar[#quar],b[i][1])
				add(quar[#quar],b[i][2])
				add(quar[#quar],i)
				b[i][1]=b[un[#un][3]][1]
				b[i][2]=b[un[#un][3]][2]
			end
		end
	elseif #quar>0 and #un<quar[#quar][1] then
		for i=2,#quar[#quar],3 do
			b[quar[#quar][i+2]][1]=quar[#quar][i]
			b[quar[#quar][i+2]][2]=quar[#quar][i+1]
		end
		deli(quar,#quar)
	end
	
	unt=#un
	
	for i=g+2,#b do
		if b[i][3]==5 then
			local qz={true,true,true,true}
			for j=g+2,#b do
				if (eq(b[i],b[j])) qz[b[j][4]]=false
			end
			if (qz[1]) rectfill(b[i][1]*16,b[i][2]*16,b[i][1]*16+7,b[i][2]*16+7,1)
			if (qz[2]) rectfill(b[i][1]*16+8,b[i][2]*16,b[i][1]*16+15,b[i][2]*16+7,1)
			if (qz[3]) rectfill(b[i][1]*16,b[i][2]*16+8,b[i][1]*16+7,b[i][2]*16+15,1)
			if (qz[4]) rectfill(b[i][1]*16+8,b[i][2]*16+8,b[i][1]*16+15,b[i][2]*16+15,1)
			for j=2,g+1 do
				if eq(b[i],b[j]) then
					if (qz[1]) spr(32,b[i][1]*16,b[i][2]*16)
					if (qz[2]) spr(33,b[i][1]*16+8,b[i][2]*16)
					if (qz[3]) spr(48,b[i][1]*16,b[i][2]*16+8)
					if (qz[4]) spr(49,b[i][1]*16+8,b[i][2]*16+8)
				end
			end
		end
	end
end


function metaundo()
	a={}
	if (metu==nil) return
	for i=1,#metu do
		if not contains(metu[i][1],metu[i][2]) then
			add(a,{metu[i][1],metu[i][2]})
		end
	end
end
