function title()
 print("ver:.9",98,3,13)
 print("\^w\^ actic\noe",51,43,7)
 
 te(0) 
 pal(1,6)
 te(2*(flr(time())%2))
 pal(1,1)
 
 print("by bens\n +kristen",68,50,14)
	
	rect(0,93,128,93,10)
	rectfill(0,95,127,112,14)
 rect(0,114,128,114,10)
	
	local tops={"play","make","info"}
	print("\^w\^ "..tops[t_mode+1],51,102,1)
	print("\^w\^ "..tops[t_mode+1],50,101,10)	
	spr(3,38,101)
	spr(4,85,101) 

 for i=1,#is do
 	if (is[i]==148) is[i]=-27
 	is[i]+=1
 	print("press  ",is[i],119,7)
 	print("c",is[i]+22,119,10)
 end

 
 if counter>5 then
 	cls()
 	if counter<20 then
 	 col=10
 	elseif counter>40 then
 		col=8
 	else
 		col=9
 	end
 	print("hold x to delete", 33,70,7)
 	rectfill(34,60,94,65,6)
 	rectfill(34,60,34+counter,65,col)
 end
	--update
	
	if (counter==-1) then
		w+=1
		cls()
 	print("save file deleted", 30,64,8)
		dset(1,0)
		if(w==90) run()
		return
	elseif btn(❎) then
		counter+=1
		if (counter>=60) w=0 counter=-1
	else
		counter=0
	end
	
	if btnp(🅾️) then
		if t_mode==0 then
			mode="lpack"
		elseif t_mode==1 then
			mode="editor" lp=-1
		elseif t_mode==2 then
			mode="info"
		end
	end
	if(btnp(⬅️)) t_mode-=1
	if(btnp(➡️)) t_mode+=1
	t_mode%=3
end

function info()
	back()
	
	spr(10,118,113,2,2)
	print("\^w\^t thank you\nfor playing!",20,15,10)
	print("\^w\^t thank you\nfor playing!",19,14,14)
	print("playtesters:",10,50,7)
	print("sam ryver leia josh jaron\nmichelle morgan allison\nphilip georgie ezan",14,58,7)
	print("special thanks:",10,83,10)
	print("alan baker\ntom armstrong\ndanah screen\nkeith o'hara\nvasanta chaganti",14,91,10)

	if (btnp(❎)) mode="title"
end

function tutorial()
	back()
	print("\t\t\t rules\n\n\n\n\n\n\nthis block can move\n\n\n\n\n\nthis one can't",5,10,7)		
	print("win: get block on goal",5,22,10)
	print("move: push off adjacent blocks",5,34,14)
		
	spr(36,10,62,2,2)
	spr(17,46,66)
	spr(64-28*flr((time()/3)%2),26+16*flr((time()/3)%2),62,2,2)
	
	spr(36,10,98,2,2)
	spr(96,42,98,2,2)

	if (btnp(❎)) mode="lpack"
end

function editor()
 cls(13)
 rectfill(16,16,111,111,1)
 set_b(elvl)
 for i=2,#b do
 	local blsp=32+b[i][3]*2
		spr(blsp,b[i][1]*16,b[i][2]*16,2,2)	
 end

	blsp=32+code*2
 if (code==5) blsp=44
 if (inbounds(x,y)) or code==1 then
  spr(blsp,x*16,y*16,2,2)
 end
	
	color(7)
	if (x==0 and y==1) color(10) txt="exit"
	print("⌂",4,21)
	
 color(7)
	if (x==0 and y==2) color(10) txt="run"
 print("☉",4,37)
 
 color(7)
	if (x==0 and y==3) color(10) txt="erase"
 print("✽",4,53)
	
 if not(x==0 and y>0 and y<4) then
 	txt="c to change, x to place"
 	spr(6,x*16,y*16,2,2)
 end
 
 print(txt, 64-#txt*2, 118,6)

	if (btnp(⬅️)) x-=1
	if (btnp(➡️)) x+=1
	if (btnp(⬆️)) y-=1
	if (btnp(⬇️)) y+=1
	x=min(max(x,0),7)
	y=min(max(y,0),7)
	
	typename={
	 "goal",
	 "stone",
	 "regular",
	 "rocket",
	 "knight",
	 "delete"
 }
	
	print(typename[code+1],64-#typename[code+1]*2,4,7)
	
	if (btnp(🅾️)) editor_c()
	if (btnp(❎)) editor_x()
end


function editor_c()
 if x==0 then
 	if y==1 then
 		mode="title"
 		lp=dget(1)
		elseif y==2 then
			mode="level"
 	elseif(y==3) then
 		elvl={"your level!"}
 	end
 else
 	code+=1
 	if (code==6) code=0
 end
end

function editor_x()
	for i=2,#b do
		if eq({x,y},b[i]) then
			deli(elvl,i)
			break
		end
	end
	if(code==5) return
	local ein=nil
	if (code==0) ein=2 
	if inbounds(x,y) or code==1 then
		add(elvl,100*x+10*y+code,ein)
	end
end

function sel()
	local cur_sel=0
	local lst_sel=-cur*12
	if cur<3 then
		cur_sel=-12*(3-cur)
		lst_sel=-36
	elseif cur>#lvls[lp]-2 then
		cur_sel=12*(2-(#lvls[lp]-cur))
		lst_sel=-(#lvls[lp]-2)*12
	end
	
	rectfill(12,90+cur_sel,113,100+cur_sel,14)
	circfill(12,95+cur_sel,5,14)
	circfill(116,95+cur_sel,5,14)
	
	--draw all level tabs
	for i=1,#lvls[lp] do
		color(6)
		if (cur==i) color(10)
		if (i<dget(lp)+1) spr(21,100,91+12*i+lst_sel)
		if (i>dget(lp)+1) spr(16,100,92+12*i+lst_sel)
	 print(i..". "..lvls[lp][i][1],16,93+12*i+lst_sel)
	end

 --draw preview level
 rectfill(0,0,128,64,1)
	lv=lvls[lp][cur]
 
 local pall={1,6,12,8,7}
 for i=2,#lv do	 
 	lv[i]=tostr(lv[i])
 	if (#lv[i]==2) lv[i]="0"..lv[i]
		if (#lv[i]==1) lv[i]="0".."0"..lv[i]
 	local ps=tonum(lv[i][3])
		
		pal(1,pall[max(ps,1)])
 	spr(1+min(ps,1),(lv[i][1]+4)*8,lv[i][2]*8)
 	pal(1,1)
	end 
	
	back()

	if btnp(🅾️) then
		mode="level"
		set_b()
		x=1
		y=1
	end
	if (btnp(❎)) mode="lpack" lpshift=-80*(lp-1) 
 if (btnp(⬆️) and cur>1) cur-=1
 if (btnp(⬇️) and cur<=min(dget(lp),#lvls[lp]-1)) cur+=1
 
end

	

function lpack()

	back()
	
	if((lp-1)*-80>lpshift) lpshift+=6
	if((lp-1)*-80<lpshift) lpshift-=6	 
	
	ro=flr(lpshift/-80+1.5)

	for i=max(ro-1,1),min(ro+1,#lplogos) do
		upz=0
		
		if lp==i then 
			upz=-1
			rectfill(lpshift+33+(i-1)*80,31,lpshift+96+(i-1)*80,94,10)
		end
		
		lpack_square(lplogos[i],lpshift+34+(i-1)*80,34+upz)
		txt=tostr(dget(i)).."/"..tostr(#lvls[i])
		if (i==1) txt=" press c"
		print(txt,lpshift+64-2*#txt+(i-1)*80,100,7)		

		if i!=1 and dget(i)==#lvls[i] then
			spr(21,5+(i)*80+lpshift,35+upz)
		end
	end

	if btnp(🅾️) then
		dset(1,lp)
		if lp==1 then
			mode="tutorial" 
		else
			mode="sel"
			cur=min(dget(lp)+1,#lvls[lp])
		end
	end
	if(btnp(❎)) mode="title"
	if(btnp(➡️) and lp<#lplogos) then
  lp+=1
 elseif(btnp(⬅️)and lp>1) then
  lp-=1
 end
end

function level()
	cls()
	rectfill(16,16,111,111,1)
	
	color(7)
	if (x==0 and y==1) color(10)
	print("⌂",4,21)
	
	color(7)
	if (x==0 and y==2) color(10)
	print("☉",4,37)
	
	color(7)
	if (x==0 and y==3) color(10)
	print("✽",4,53)
	color(7)
	
	if lp==-1 then
	 txt=b[1]
	else
		txt=cur..". "..b[1] 
	end
	 
	if(fval!="") txt=fval color(10)
	print(txt, 64-#txt*2, 4)
	
	if(lp==6) exhandler()
	-- level sprites
	local o=-1
	for i=2, #b do
		local blsp=32+b[i][3]*2
		spr(blsp,b[i][1]*16,b[i][2]*16,2,2)
		if lock and eq({sx,sy},b[i]) then
			if (b[i][3]==5) o=i
			rectfill(sx*16+2,sy*16+2,(sx+1)*16-3,(sy+1)*16-3,10)
			sdx=3
			sdy=3
			if (x<sx)sdx+=-1
			if (x>sx)sdx+=1
			if (y<sy)sdy+=-1
			if (y>sy)sdy+=1
			local upn={16*b[i][3]-29,35}
			if(#a==0) upn[2]=51
			sspr(upn[1],upn[2],10,10,sx*16+sdx,sy*16+sdy)			
		end
	end
	
	if(lp==7) orwell(o)

	if (x!=0) spr(cf,x*16,y*16,2,2)

	if (currwon) level_won() return
	if (not lock) level_unlocked() return
	if (lock) level_locked() return
end

function level_unlocked()
 cf=6 
	
	if (btnp(⬅️) and (x>1 or (x==1 and y<4))) x-=1
	if (btnp(➡️) and x!=6) x+=1
	if (btnp(⬆️) and y!=1) y-=1
	if (btnp(⬇️) and ((y<6 and x>0) or y<3)) y+=1
	
	txt=""
	
	if(x==0) then
		if (y==1) then
			txt="level select"
		elseif (lp!=6 and lp!=7) then	
			if y==2 then
				txt="see if 3 moves away"
			elseif y==3 then
				txt="restart level"
			end	
		else
			if y==2 then
				txt="rules"
			elseif y==3 then
				txt="restart level"
			end
		end
	elseif(lp!=-1 and dget(lp)<#lvls[lp]/3) then
		txt="c to select, x to undo"	
	end
	print(txt,64-#txt*2,118,6)
	
	if btnp(🅾️) then
		fval=""
		if (x==0) then
			if y==1 then
				if (lp==-1) mode="editor" return
				mode="sel"
			elseif y==2 and lp!=6 and lp!=7 then
				fval=future(3)
			elseif y==2 then
				fval=orlis[cur][3]
			elseif y==3  then
				if (lp==-1) set_b(elvl) return
				set_b()
			end
			return
		end
		
		for i=g+2,#b do
			if eq({x,y},b[i]) and b[i][3]>1 then
				lock=true
				rock=false
				sx=x sy=y
				blocks(b[i])
				sfx(2)
				break
			end
		end
	end
	
	
	if btnp(❎) and #un>0 then
		fval=""
		b[un[#un][3]][1]=un[#un][1]
		b[un[#un][3]][2]=un[#un][2]
		deli(un,#un)
		sfx(1)
		if ((lp!=6 or cur!=11) and #metu>0)deli(metu,#metu)
	end
end


function level_locked()
		-- yellow dots
		for i=1,#a do
			local r=17
			local xflip=false
			local yflip=false
			local dx=a[i][1]
			local dy=a[i][2]
			if rock then
				r=18
				dx=rb[i][1]
				dy=rb[i][2]
				if(dx==sx) r=20
				if(dy==sy) r=19
				if(dy<=sy) yflip=true
			 if(dx<=sx) xflip=true
			end
			spr(r,dx*16+4,dy*16+4,1,1,xflip,yflip)
		end
		
		rx=x ry=y
		if (btnp(⬆️)) ry=y-1
		if (btnp(⬅️)) rx=x-1
		if (btnp(➡️)) rx=x+1
		if (btnp(⬇️)) ry=y+1
		
		if inbounds(rx,ry) and abs(sx-rx)<val and abs(sy-ry)<val	then
	 	x=rx y=ry
		end

	cf=6+2*(flr(time())%2)
	if (cf==8 and eq({sx,sy},{x,y})) cf=14
	
	if btnp(🅾️) then
		for j=1,#a do	
			local dx=a[j][1] 
			local dy=a[j][2]
			if rock then
				dx=rb[j][1]
				dy=rb[j][2]
			end	 
			if x==dx and y==dy then
	 		for i=g+2,#b do
					if eq({sx,sy},b[i]) and (not (lp==7 and orlis[cur][1]==toggle and b[i][3]==5 and i%2!=#un%2))  then 
						add(un,{b[i][1],b[i][2],i})
						if ((lp!=6 or cur!=11)) add(metu,{b[i][1],b[i][2],i})
						x=a[j][1]
						y=a[j][2]
						b[i][1]=x
						b[i][2]=y
						sfx(0)
						break
					end
				end
			 break
		 end
	 end
	 lock=false 
	 
		currwon=won()
		
		if currwon==true	then
			gnum=0
			cf=-20
			parts_init()
			mselect=1
			if lp!=-1 and dget(lp)<cur then
				dset(lp,dget(lp)+1)
			end	
			return
		end
	end
	if (btnp(❎)) lock=false 
end

function level_won()
	parts_draw()
	
	counter+=1
 if(lp==-1 or lp==1) counter=0
 if(counter>=25) rect(33,45,94,80,10)
 if(counter>=27) rectfill(34,46,93,79,14)
  
 if counter>=30 then
		txt="next level"
		
		if(cur>=#lvls[lp]) txt="continue"
		
		color(7)
		if(mselect==1) color(10)
		print(txt,38,50)
		
		color(7)
		if(mselect==2) color(10)
		print("level select",38,60)
		
		color(7)
		if(mselect==3) color(10)
		print("retry",38,70)
	end

	if(btnp(⬆️)and mselect>1) mselect-=1
	if(btnp(⬇️)and mselect<3) mselect+=1
	
	if (btnp(❎) and mode=="level") mselect=2
	
	if btnp(🅾️) or btnp(❎) then
		currwon=false
		counter=0
	 
	 if (lp==-1) set_b(elvl) mode="editor" return
	 
		if mselect==1 then
			if (cur==#lvls[lp]) then
				mode="lpack"
			else
				if (cur<#lvls[lp]) cur+=1
				set_b()
			end
		elseif mselect==2 then
			if (cur<#lvls[lp]) cur+=1
			mode="sel"
		elseif mselect==3 then
			set_b()
		end
	else
		parts_update()
	end
end
