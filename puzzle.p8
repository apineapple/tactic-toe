	poke(0x5f2d,1)
	t_mode,tob,bot,tops,mt,mpc,mc,mpt,mpx,mpy,mx,my,typename,is,t_,a,elvl,mode,x,y,code,lplogos=0,0,{},split("play,make,free,dele,info"),0,0,function() return stat(34) end,90,0,0,function() return stat(32)-2 end,function() return stat(33)-2 end,split("goal,stone,regular,rocket,knight,delete"),split("8,43,78,113,148"),0,{},"","boot",1,1,0,split(",,,,,,,",",",false)
	
	
	
