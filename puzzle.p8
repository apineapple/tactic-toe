--experimental


function key()
	spr(12,bp(g,1),bp(g),2,2)
	currwon=eq(b[g],b[2])
end

function least()
	if (#un>3) currwon=false
end

function lose()	
	currwon=true
	for i=g,#b do
		blocks(b[i])
		if (#a!=0) currwon=false
	end
	if (lock) blocks(b[lock])
end

function evolve()
	for i=g, #b do
		b[i][3]=(b[i][3]+#un-unt-1)%4+1
	end
	unt=#un
end

function odnu()
	if #un>unt then
		local tun=una()
		add(un,{tun[1],tun[2],tun[3]},1)
		deli(un,#un)
	end
	unt=#un
end

function mirror()
	if unt<#un and not getblock(7-b[una()[3]][1],b[una()[3]][2]) then
		mi=getblock(7-una()[1],una()[2])		
		if mi then	
			add(un2,{b[mi][1],b[mi][2],mi,#un})
			b[mi][1],b[mi][2]=7-b[una()[3]][1],b[una()[3]][2]
		end
	elseif #un2>0 and #un<un2[#un2][4] then
		local un2m=un2[#un2]
		b[un2m[3]][1],b[un2m[3]][2]=un2m[1],un2m[2]
		deli(un2,#un2)
	end
	unt=#un
end

function press()
	for i=1,#un2 do
		if not getblock(un2[i][1],un2[i][2]) then
			spr(110,un2[i][1]*16,un2[i][2]*16,2,2)
		end
	end
	
	if unt<#un then
		for i=2,g-1 do
			if getblock(b[i][1],b[i][2]) then
				add(un2,{b[i][1],b[i][2],i,#un})
			end
		end
	elseif #un2>0 and #un<un2[#un2][4] then
		deli(un2,#un2)	
	end
	unt,currwon=#un,g==#un2+2
end

function hybrid()
	if (unt!=0) lock=getblock(sx,sy)
	for i=g,#b do
		if b[i][3]>1 then
			blsp=(b[i][3]-1)%3+2
			if i==lock then
				if mlclk() and lock==getblock(x,y) then
					unt=unt%2+1
					blocks(unt==2 and b[lock] or unt==1 and {b[lock][1],b[lock][2],blsp})
				elseif clk() then
					unt=0
				end
				if unt==1 then
					lockblock(8)						
					spr(32+b[i][3]*2,bp(i,1),bp(i),1,2)	
				end
			end
			if i!=lock or unt!=1 then
				spr(33+2*blsp,bp(i,1)+8,bp(i),1,2)	
			end
		end
	end
end

function stack()
	rb={}
	if lock then
		
		if b[lock][3]!=4 then
		 reg(b[lock][1],b[lock][2])
		else
			knight(b[lock][1],b[lock][2])
		end
		
		if b[lock][3]==3 then
			for i=1,#a do
				rb[i]={}
				rb[i][1],rb[i][2]=a[i][1],a[i][2]
				qx,qy=a[i][1]-b[lock][1],a[i][2]-b[lock][2]
				if (qx==1) qx=6
				if (qx==-1) qx=1
				if (qy==1) qy=6
				if (qy==-1) qy=1
				a[i][1],a[i][2]=qx,qy
			end
		end
	end
end

function swatch(s,v)
	x=btnp(➡️) and x==6 and 7 or min(x,7)
	
	for i=1,#s do
		if i!=clock and s[i] then
	  spr(90+s[i],116,i*16+4)
	 end
	end
	
	vb=getblock(x,y)
	
	if mlclk() then
		if clock then
			if v==1 and vb and b[vb][3]==1 then
				b[vb][3]=s[clock]
			elseif v==2 and not vb and inbounds(x,y) and (x!=1 or y!=1) and (x!=5 or y!=6)  then
				add(b,{x,y,s[clock]})
				vb=#b
			else
				vb=nil
			end
			if vb then
				add(un2,{s[clock],clock,vb,#un+1})
				s[clock]=nil
			end
			clock=nil
		else
			for i=1,#s do
				if (eq({x,y},{7,i}) and s[i]) clock=i
			end
		end 
	end
	
	if mlrlk() and not lock and #un2>0 and un2[#un2][4]>#un then
		s[un2[#un2][2]]=un2[#un2][1]
		if (v==1) b[un2[#un2][3]][3]=1
		if (v==2) deli(b,un2[#un2][3])
		deli(un2,#un2)
	end
	
	pal(14,10)
 spr(clock and 90+s[clock],x*16+4,y*16+4)
 palr()
end

function palette()
	if (#un2==0) swa={2,2,3,3,4}
	swatch(swa,1)
end

function crane()
	if (#un2==0) swa={2,3,4}
	swatch(swa,2)
end

function match()
	for i=2,4 do
		mvg=getblock(b[i][1],b[i][2])
		if mvg then
			if(i!=b[mvg][3]) currwon=false
		else
			
			spr(100+2*i,bp(i,1),bp(i),2,2)
		end
	end
end

function double()
	if dlock then
		ta=makea()
		blocks(b[dlock])
		pal(10,3)
		y+=1
		dotdot(dlock)
		a=ta

		blsp=b[dlock][3]
		spr(44,bp(dlock,1),bp(dlock),2,2)
		tsy,tsx=sy,sx
		sx,sy=b[dlock][1],b[dlock][2]
		lockblock()
		sy,sx=tsy,tsx
		y-=1
	end
	
	if mlclk() then
		if lock then
			dlock=nil
		else
			dlock=getblock(x,y+1)
			if (dlock and b[dlock][3]<2) dlock=nil
		end
	end
	
	pal(7,3)
	if mt<80 then
		spr(14+32*min(mc(),1),mx(),my()+16,2,2)
	else
		spr(cf,x*16,y*16+16,2,2)
	end
	palr()
end

function metaundo()
	if lp!=6 or cur!=14 then
		if (#un==0) metu={}
		if #un>#metu then
			add(metu,{un[#un][1],un[#un][2],un[#un][3]})
		elseif #un<#metu then
			deli(metu,#metu)
		end
	else
		if #un==0 and metu then
			for i=1,#metu do
				mu=metu[i]
				add(un,{mu[1],mu[2],mu[3]})
			end
		end	
	end
end


function cube()
	rectfill(16,16,111,111,0)
	cf=-1
	x,y=-0,mpx>16 and 0 or y
	ssc={
	split("138,134,214,160,212"),
	split("136,132,208,162,210"),
	split("180,205,200,128,232")
	}
	btemp=maketemp()
	for i=g,#b do
		--add in lock
		if b[i][2]==3 and b[i][1]>3 then
			add(b,{4,b[i][1],2})
		elseif b[i][2]==3 and b[i][1]>3 then
			add(b,{b[i][2],4,2})
		end
	end
	if lock then 
		for i=1,#a do
			if b[lock][1]<4 and b[lock][2]>3 and a[i][1]>3 and a[i][2]>3 then
				a[i][1]=a[i][2]
				a[i][2]=3
			elseif b[lock][2]<4 and b[lock][1]>3 and a[i][2]>3 and a[i][1]>3 then
				a[i][2]=a[i][1]
				a[i][1]=3
			end
		end
	end
	
	for x3=1,6 do
		for y3=1,6 do
			tx3,ty3=x3,y3			
			bl3=getblock(x3,y3) --block present
			d3t=nil
			cl3ck=nil
			
			if lock then
				for i=1,#a do
					if (eq(a[i],{x3,y3})) d3t=true
				end
			end
			

			if x3>3 and y3<4 then
				x3,y3=4-y3,7-x3
				cl3ck=mclk(52+13*x3,101-4*x3-y3*15,10,7)
				spr(cube_spr(ssc[1]),48+13*x3,96-4*x3-y3*15,2,3)
			elseif y3>3 and x3<4 then
				y3-=3
				cl3ck=mclk(13+13*x3,25+4*x3+y3*15,10,8)
				spr((not bl3) and x3==2 and y3==2 and (d3t and 140 or 219) or cube_spr(ssc[2]),12+13*x3,20+4*x3+y3*15,2,3)
			elseif x3<4 and y3<4 then
				x3,y3=x3,4-y3		
				cl3ck=mclk(2+13*x3+y3*13,31+5*x3-y3*5,11,8)
				spr(cube_spr(ssc[3]),1+13*x3+y3*13,31+5*x3-y3*5,3,2)				
			end
			x3,y3=tx3,ty3
			if (cl3ck and (d3t or bl3)) x,y=x3,y3
		end
	end
	b=btemp
end

function cube_spr(sc)
	return bl3 and (bl3==lock and (#a==0 and sc[1] or sc[2]) or sc[3]) or d3t and sc[4] or sc[5]
end

-->8
--orwell

function chain()
	if o then
	 blocks({b[o][1],b[o][2],2})
	elseif #un>unt then
		add(b,{una()[1],una()[2],5})
	elseif #un<unt then
		deli(b,#b)
	end
	unt=#un
end

function eye()
 bx,by=b[o][1],b[o][2]
	a={}
	for i=g,#b do
		if i!=o then
			add(a,{2*bx-b[i][1],2*by-b[i][2]})
		end
	end
	for i=1,#a do
		for j=1,#a do
			add(a,eq(b[o],{a[i][1],a[j][2]}) and bx-a[i][1]==by-a[j][2] and {a[j][1],a[i][2]} or a[i][1]==a[j][1] and (a[i][2]+a[j][2])/2==by and {a[i][1],by} or a[i][2]==a[j][2] and (a[i][1]+a[j][1])/2==bx and {bx,a[i][2]} or nil)
		end
	end
	bcut()
end

function toggle()	
	btemp=maketemp()	
	for i=9-#un%2,7,-2 do
		deli(b,i)
		if not getblock(btemp[i][1],btemp[i][2]) then
			dorwell(btemp[i],true)
		end
	end
	if (lock!=6) spr(36,bp(6,1),bp(6),2,2)
	
	if (getblock(sx,sy)) blocks({sx,sy,2})
	b=btemp
end

function dead()
	local btemp=maketemp()
	if (o) lock=false
	for i=10,9,-1 do
		dorwell(b[i])
		deli(b,i)
	end	

	if (lock) blocks(b[lock])
	
	b=btemp
	bcut()
end

function meta()
	a={}
	for i=1,6 do
		for j=1,6 do
			add(a,{i,j})
		end
	end
	bcut()
end

function undo(una)
	a={}
	una=una or un
	for i=1,#una do
		add(a,{una[i][1],una[i][2]})
	end
	bcut()
end

function bishop()
	local bx,by=b[o][1],b[o][2]
	blocks({bx,by,2})
	for i=#a,1,-1 do
		if bx==a[i][1] or by==a[i][2] then
			deli(a,i)
		end
	end
end

function bulldozer()
	if o then
		reg(b[o][1],b[o][2])
	elseif #un>unt then
		for i=g,#b do
			if i!=una()[3] and eq(b[i],b[una()[3]]) then
			 add(un2,{b[i][1],i,#un})
				b[i][1]=-1
			end
		end
	elseif	#un2!=0 and #un<un2[#un2][3]	then
		b[un2[#un2][2]][1]=un2[#un2][1]
		deli(un2,#un2)
	end
	unt=#un
end

function gap()
	eye(o)
	for i=#a,1,-1 do
		if abs(b[o][1]-a[i][1])!=2 and abs(b[o][2]-a[i][2])!=2 then
			deli(a,i)
		end
	end
end

function quarter()
	qub={[3]=1,[4]=2,[6]=4,[7]=3}
	if lock then
		local btemp=maketemp()
		qs,qz=4,{true,true,true,true}
		
		if o then
			qs,qz=0,{}
			for i=g,#b do
				if eq(b[i],b[o]) then 
					qs+=1 
					qz[qub[i]]=true
				end
			end
		end
	
		for i=#b,g,-1 do
			if b[i][3]==5 then
			 local qua=0
				for j=g,#b do
					if (eq(b[i],b[j])) qua+=1
				end
				if (qua<qs) deli(b,i)
			end
		end
		
		reg(btemp[lock][1],btemp[lock][2])
		b=btemp
		
		for i=#a,1,-1 do
			for j=g,#b do
				if eq(a[i],b[j]) and (b[j][3]!=5 or qz[qub[j]]) then
					deli(a,i)
					break
				end
			end
		end
	end
	
	currwon=true
	for i=2,g-1 do
		local cqu=0
		for j=g,#b do
			if eq(b[i],b[j]) then
				if (b[j][3]!=5) cqu=4 
				cqu+=1
			end
		end
		if (cqu<4) currwon=false 
	end

	qu2=un2[#un2] 	
	if #un>unt then
		add(un2,{#un})
		qu=una()
		for i=g,#b do
			if eq(b[i],qu) then	
				qu2=un2[#un2]
				add(qu2,b[i][1])
				add(qu2,b[i][2])
				add(qu2,i)
				b[i][1],b[i][2]=b[qu[3]][1],b[qu[3]][2]
			end
		end
	elseif qu2 and #un<qu2[1] then
		for i=2,#qu2,3 do
			b[qu2[i+2]][1],b[qu2[i+2]][2]=qu2[i],qu2[i+1]
		end
		deli(un2,#un2)
	end
	unt=#un
	
	for i=g,#b do
		if b[i][3]==5 then
			local qz={}
			for j=g,#b do
				if (eq(b[i],b[j])) qz[qub[j]]=true
			end
			gsx={0,8,0,8}
			gsy={0,0,8,8}
			for k=1,4 do
				if (not qz[k]) spr(5,bp(i,1)+gsx[k],bp(i)+gsy[k])
				for j=2,g-1 do
					if (eq(b[i],b[j]) and not qz[k]) spr(179+k,bp(i,1)+gsx[k],bp(i)+gsy[k])
				end
			end
		end
	end
end

function shy()
	reg(b[o][1],b[o][2])
	if (#a!=0) a={} return
	for dx=-1,1 do 
		for dy=-1,1 do
			add(a,{b[o][1]+dx,b[o][2]+dy})
		end
	end
	bcut()
end

function glue()
	for i=g,#b do
		if b[i][3]==5 then
			meu=nil
			mer=nil
			meb=nil	
		for j=g,#b do
				if b[j][3]==5 then
					local ms={}
					if (eq({b[i][1]-1,b[i][2]+1},b[j])) meb=true
					if eq({b[i][1],b[i][2]-1},b[j]) then
						ms={2,0,13,2}
					elseif eq({b[i][1]+1,b[i][2]},b[j]) then
						ms={13,2,15,13}
					elseif eq({b[i][1],b[i][2]+1},b[j]) then
						ms={2,13,13,15}
						meu=true
					elseif eq({b[i][1]-1,b[i][2]},b[j]) then
						ms={0,2,2,13}
						mer=true
					end
					if #ms==4 then
						if (lock==i) lock=nil
						rectfill(bp(i,1)+ms[1],bp(i)+ms[2],bp(i,1)+ms[3],bp(i)+ms[4],7)									
					end
					if meu and mer and meb then
						rectfill(bp(i,1)-2,bp(i)+14,bp(i,1)+1,bp(i)+17,7)									
					end
				end
			end
		end
	end	

	if (lock) blocks({b[lock][1],b[lock][2],2})
end
 
function portal()
	p={2,6}
	
	for i=1,2 do
		ps=i%2+1
		if not getblock(p[i],p[i]) then
			dorwell({p[i],p[i]},true)
		elseif unt<#un and eq(b[una()[3]],{p[i],p[i]}) and (not getblock(p[ps],p[ps])) then
			b[una()[3]][1],b[una()[3]][2]=p[ps],p[ps]
			break
		end
	end	
	
	unt=#un
end

function bubble()
	--bub=bub or {}
--	if #un>unt then
--		for dx=-1,1 do 
--		for dy=-1,1 do
--				bu=getblock(dx+un[un[#un][3]][1],dy+un[un[#un][3]][2])
--				if bu then
--					add(bub,{bu,un[#un][3],b[bu][1]})
--					b[bu][1]=-1
--				end
--			end
--		end
--	elseif #bub>0 and #un<unt then
--		
--	end
--	#un=unt
	--]]
end

function wrap()
	btemp=maketemp()
	for i=g,#btemp do
		wx,wy=b[i][1],b[i][2]
		wx,wy=wx==1 and 7 or wx==6 and 0,wy==1 and 7 or wy==6 and 0
		add(b,{wx,wy,1})
	end
	reg(b[lock][1],b[lock][2])
	
	for i=1,#a do
		wx,wy=a[i][1],a[i][2]
		wx,wy=wx==0 and 6 or wx==7 and 1 or wx,wy==0 and 6 or wy==7 and 1 or wy
		a[i][1],a[i][2]=wx,wy
	end
	b=btemp
	bcut()
end
