--modes
function boot()
	--load in level like bootup
	if #bot<64 and tob==0 then
		cls()
		add(bot,{34+2*flnd(4),16*(#bot%8),16*flr(#bot/8)})
		if (#bot==64) tob+=1
	elseif tob>0 then
		if (tob>8) deli(bot,flnd(#bot))
		title() 
		tob+=1
	end
	
	for e in all(bot) do
		spr(e[1],e[2],e[3],2,2)
	end
	if (#bot==0 or mlclk()) mode="title"
end


function title()
 ?"\f6ver:0.9",98,3
 ?"\f7\^w\^ actic\noe",51,43
 ?"\feby bens\n +kristen",68,50

	tim=flr(time())%2
 te(0) 
 pal(1,6)
 te(2*tim)
 palr()
	rect(0,93,128,93,10)
	rectfill(0,95,127,112,14)
 rect(0,114,128,114,10)
  
 for i=2,#lvls do
 	if dget(i)==#lvls[i]/2 then
 		spr(2,5,10*i-17)
 	end
 end
	?"\f1\^w\^ "..tops[t_mode+1],51,102
	?"\fa\^w\^ "..tops[t_mode+1],50,101
	
	spr(3,38-tim,101)
	spr(4,85+tim,101) 
 
 for i=1,#is do
 	if (is[i]==148) is[i]=-27
 	is[i]+=1
 	?"\f7press \fac",is[i],119
 end
	
	if btnp(🅾️) or mclk(48,95,34,17)  then
		if t_mode==0 then
			lp=dget(1)
			mode,lpshift="lpack",(lp-1)*-80
		elseif t_mode==1 then
			mode,lp="editor",-1
		elseif t_mode==2 then
			mode,lp="free",1
		elseif t_mode==3 then
			mode,counter="delete",0
		else
			mode="info"
		end
	end

	if(btnp(⬅️) or mclk(30,95,17,17)) t_mode-=1
	if(btnp(➡️) or mclk(83,95,100,17)) t_mode+=1
	t_mode%=5

end

function free()
	if ffval then
		level()
	elseif back() then
	 mode="title"
	else
		?"\f6generating level (30 sec)",15,62
		fs=""
		for i=1,flnd(3) do
			fs=tostr(flnd(6))..tostr(flnd(6))..tostr(0)..fs
		end
		for i=1,5+flnd(2) do
			fs..=tostr(flnd(6))..tostr(flnd(6))..tostr(flnd(4))
		end
		set_b({"endless",fs})
		for i=2,#b do
			for j=2,#b do
				if (eq(b[i],b[j]) and i!=j) return
			end
		end
		ffval=future(3)
		if ffval=="close!" or future(5)=="not close" then
			ffval=nil
		end
	end
end

function info()
	spr(238,110,112,2,2)
	?"\fa\^w\^t thank you\nfor playing!",20,15
	?"\fe\^w\^t thank you\nfor playing!",19,14
	?"\f7playtesters:",10,50
	?"\f7sam ryver leia josh jaron\nmichelle morgan allison\nphilip georgie ezan\n\fa\n\nalan baker\ntom armstrong\ndanah screen\nkeith o'hara\nvasanta chaganti",14,58
	?"\faspecial thanks:",10,80


	if (back()) mode="title"
end

function delete()
	cls()
	if (back()) mode="title"
	
	?"\f7\thold c to\n\n\n\ndelete save file", 33,48
 rectfill(34,60,94,65,6)
 rectfill(34,60,34+counter,65,col)
 
 col=counter<5 and 6 or counter<20 and 10 or counter>40 and 8 or 9 
	
	if counter==-1 then
		w+=1
		cls()
 	?"\f8save file deleted", 30,62
		dset(1,0)
		dset(10,0)
		if(w==90) run()
	elseif btn(🅾️) then
		counter+=1
		if (counter>=60) w=0 counter=-1
	else
		counter=0
	end
end

function tutorial()
	?"\f7\t\t\t rules\n\n\fa\#1win:  \f1\#aget a block on the goal\n\n\fe\#1move: \f1\#epush off adjacent blocks\f7\#1\n\n\n\nthis block can move\n\n\n\n\n\n...then it can't",5,10		

	spr(36,39,68,2,2)
	spr(17,75,72)
	spr(64-28*flr((time()/3)%2),55+16*flr((time()/3)%2),68,2,2)
	spr(36,39,104,2,2)
	spr(96,71,104,2,2)

	if (back()) mode="lpack"
end

function editor()
	set_b({"your level!",elvl})
	
	dset(10,ceil(#elvl/4))
	for i=1,dget(10) do
		tol=sub(elvl,i*4-3,i*4)
		tolo=""
		for j=1,#tol do
			tolo..=tostr(1+tol[j])
		end
		dset(10+i,tonum(tolo))
	end
	
	lock=nil
	fillp(▒)
	level()
	fillp()
	x,y=max(min(7,x)),max(min(7,y))
 
 spr(90+code,x*16+4,y*16+4)
	
	if mlclk() then
		code+=1
	 code%=6
	end
	
	if mlrlk() then
		for i=#elvl,1,-3 do
			if x==tonum(elvl[i-2]) and y==tonum(elvl[i-1]) then
				elvl=sub(elvl,1,i-3)..sub(elvl,i+1,#elvl)
			end
		end
		if (code==5) return
		nlvl=tostr(x)..tostr(y)..tostr(code)
		if inbounds(x,y) or code==1 then
			elvl=code==0 and nlvl..elvl or elvl..nlvl
		end
	end
end

function sel()
	set_b()
	local cur_sel=0
	local lst_sel=-cur*12
	if cur<3 then
		cur_sel=-36+12*cur
		lst_sel=-36
	elseif cur>lnum-2 then
		cur_sel=12*(2-(lnum-cur))
		lst_sel=-(lnum-2)*12
	end
	rectfill(12,90+cur_sel,113,100+cur_sel,14)
	circfill(12,95+cur_sel,5,14)
	circfill(116,95+cur_sel,5,14)

	for i=1,lnum do
		pal(7,6)
		highlight(cur==i)
		blsp=i<dget(lp)+1 and 21 or i>dget(lp)+1 and 16 or -20
	 spr(blsp,100,91+12*i+lst_sel)
	 ?i..". "..lvls[lp][i*2-1],16,93+12*i+lst_sel
		if i<dget(lp)+2 and mclk(12,90+12*i+lst_sel,101,10,14) then
			cur=i
		end
	end
	palr()

 rectfill(0,0,128,64,1)
 for i=2,#b do	 
		spr(74+b[i][3],(b[i][1]+4)*8,b[i][2]*8)
	end 
	

	if btnp(🅾️) or mclk(4,90+cur_sel,119,10) then
		mode="level"
		x,y=1,1
	end

	if (back()) mode="lpack"
 if (btnp(⬆️) and cur>1) cur-=1
 if (btnp(⬇️) and cur<=min(dget(lp),lnum-1)) cur+=1
end

function win()
	--fix continuity
	cls(10+4*(flr(time())%15))
	lpack()
	parts_update()
	if (#parts==0) parts_init()
	
end

function lpack()
	--?"\f6 speedrun:off",2,120
	if((lp-1)*-80>lpshift) lpshift+=6
	if((lp-1)*-80<lpshift) lpshift-=6	 
	ro=flr(lpshift/-80+1.5)

	for i=max(ro-1,1),min(ro+1,#lplogos) do
		upz=0
		
		if lp==i then 
			upz=-1
			rectfill(lpshift+33+(i-1)*80,31,lpshift+96+(i-1)*80,94,10)
		end
		
		lpack_square(lplogos[i],lpshift+34+(i-1)*80,34+upz)
		txt=i==1 and "press c" or tostr(dget(i)).."/"..tostr(#lvls[i]/2)
		?txt,lpshift+64-2*#txt+(i-1)*80,100,7

		if i!=1 and dget(i)==#lvls[i]/2 then
			spr(21,5+(i)*80+lpshift,35+upz)
		end
	end
	if back() then
	 mode="title"
	elseif btnp(🅾️) or mclk(lpshift+33+(lp-1)*80,32,63,60) then
		lpshift=(lp-1)*-80
		dset(1,lp)
		if lp==1 then
			mode="tutorial" 
		else
			mode="sel"
			lnum=#lvls[lp]/2

			cur=min(dget(lp)+1,lnum)
			set_b()
		end
	elseif((btnp(➡️) or mclk(lpshift+20+(lp)*80,32,76,60)) and lp<#lplogos) then
  lp+=1
 elseif((btnp(⬅️) or mclk(lpshift+33+(lp-2)*80,32,70,60)) and lp>1) then
  lp-=1
 end
end

function level()
	cls()
	metaundo()
	rectfill(16,16,111,111,1)
	
	if (btnp(⬅️) or btnp(⬆️) or btnp(➡️) or btnp(⬇️)) mt=80
	if mt<80 then
		x=flr((mpx-4)/16+.5)%8
		y=flr((mpy-4)/16+.5)%8
	end
	o=nil
	for i=2, #b do
		spr(32+b[i][3]*2,bp(i,1),bp(i),2,2)
	end
	
	if lock then
		o=b[lock][3]==5 and lock
		spr(44,bp(lock,1),bp(lock),2,2)
		blsp=b[lock][3]
		lockblock()
	end
	
	if	lp==6 or (lp==7 and (o or orlis[cur*2]=="true")) then
		_ENV[b[1]]()
		val=lock and b[lock][3]==5 and 6 or val
	end
	
	color(7)
	txt=b[1]
	if (lp>1) txt=cur..". "..txt 
	if tonum(fval) then
	 fval=tostr(tonum(fval+1))
	 if (fval=="15") fval=future(3)
	elseif clk() then
		fval=nil
	elseif fval then
	 txt=fval color(10)
	end
	txt=mode=="editor" and typename[code+1] or txt
	?txt,64-#txt*2,6
	
	highlight(x==0 and y==1) 
	?"⌂",4,21
	

	highlight(x==0 and y==2)
	if (tonum(fval)) color(14)
	?"☉",4,37
	
	highlight(x==0 and y==3)
	?"◆",4,53
	
	
	color(7)
	
	txt=""
	if x==0 then
		if y==1 then
			txt="exit"
			if mlclk() then
				mode=(mode=="editor" or mode=="free") and "title" or lp==-1 and "editor" or "sel" 
			end
		elseif y==2 then	
			if lp<6 or lp>7 then
				txt="see if 3 moves away"
				if mlclk() then
					if mode!="editor" then
						fval="0"
					elseif g>2 then
				 	mode="level"
				 end
				end
			else
				txt="rules"
				if mlclk()  then
					fval=lp==6 and exlis[cur] or lp==7 and orlis[cur*2-1]
				end
			end
			if (mode=="editor") txt="run"	
		elseif y==3 then
			txt="restart"
			if mlclk() then
				if mode=="editor" then
					elvl=""
				else
					set_b(lp==-1 and elvl or mode=="free" and {"endless",fs})
				end
			end
		end
	end
	
	if txt=="" then	
		txt=mode!="editor" and "c to select, x to undo" or "c to choose, x to place"
	end

	?txt,64-#txt*2,118,6
	

	if ((x==0 and mode!="editor") or mt<80) cf=-20 
	spr(cf,x*16,y*16,2,2)


	if (btnp(⬅️) and (x>1 or mode=="editor" or (x==1 and y<4))) x-=1
	if (btnp(➡️) and (x!=6 or mode=="editor")) x+=1
	if (btnp(⬆️) and (y!=1 or mode=="editor")) y-=1
	if (btnp(⬇️) and ((y<6 and x>0) or y<3 or mode=="editor")) y+=1
	
	
	if currwon then
		if (lp>1 and dget(lp)<cur) dset(lp,dget(lp)+1)
		parts_update()
		cf=-20
		if (lp==-1 or mode=="free") counter=0
		counter+=1
	 if (counter>=25) rect(34,45,93,80,10)
	 if (counter>=27) rectfill(35,46,92,79,14)

	 if counter>=30 then
	 	for i=1,3 do	if(mhov(35,37+i*10,57,9)) mselect=i end
			
			highlight(mselect==1)
			?"continue",39,50
			
			highlight(mselect==2)
			?"level select",39,60
			
			highlight(mselect==3)
			?"retry",39,70
		end
	
		if(btnp(⬆️)and mselect>1) mselect-=1
		if(btnp(⬇️)and mselect<3) mselect+=1
		
		if (mlrlk() and mode=="level") mselect=2
		
		if clk() or mlclk() then
			currwon=false
		 if (lp==-1) mode="editor" return
			if (mode=="free") ffval=nil return
			if mselect==1 then
				if cur==lnum then
					mode="win"
				elseif cur<lnum then
				 cur+=1
				end
			elseif mselect==2 then
				if (cur<lnum) cur+=1
				mode="sel"			
			end
			set_b()
		end
	elseif lock then
	
		x=max(min(max(sx-val,x),sx+val),1)
		y=min(max(sy-val,y),sy+val)

		dotdot()

		cf=6+2*(flr(time())%2)
		if (eq(b[lock],{x,y})) cf=-20
	
		if (clk() or mlclk()) lock=nil 
		currwon=won()
	else 
		cf=6 
		if mlclk() and x!=0 then
			lock,sx,sy=getblock(x,y),x,y
			if (lock) blocks(b[lock])
			--	sfx(2)
		elseif mlrlk() and #un>0 then
			b[una()[3]][1],b[una()[3]][2]=una()[1],una()[2]
			deli(un,#un)
			
			--sfx(1)
		end
	end
end



